# ===== Navigos Talent Suite — cấu hình =====
# Cổng web
APP_PORT=8080

# Kết nối MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=navigos_talent
DB_USER=navigos_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# true: dự án tự chạy một instance MySQL 8 riêng (dữ liệu ở database/mysql-data, cổng DB_PORT)
# false: dùng máy chủ MySQL có sẵn (đặt DB_PORT=3306 và tài khoản tương ứng, rồi chạy database/schema.sql)
MYSQL_MANAGED=true
MYSQL_BASEDIR=C:/Program Files/MySQL/MySQL Server 8.0

# Chế độ demo: cho phép chuyển nhanh tài khoản và khôi phục dữ liệu mẫu
DEMO_MODE=true
